# Visual Studio user specific files
.vs/
UE5/KOLCHOZ/.vs/
UE5/test/.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Project files
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
UE5/KOLCHOZ/*.sln
UE5/test/*.sln

# Binary Files
UE5/KOLCHOZ/Binaries/*
UE5/KOLCHOZ/Plugins/**/Binaries/*

UE5/test/Binaries/*
UE5/test/Plugins/**/Binaries/*

# Builds
UE5/KOLCHOZ/Build/*
UE5/test/Build/*

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
UE5/KOLCHOZ/Saved/*
UE5/test/Saved/*

# Compiled source files for the engine to use
UE5/KOLCHOZ/Intermediate/*
UE5/KOLCHOZ/Plugins/**/Intermediate/*

UE5/test/Intermediate/*
UE5/test/Plugins/**/Intermediate/*


# Cache files for the editor to use
UE5/KOLCHOZ/DerivedDataCache/*
UE5/test/DerivedDataCache/*
